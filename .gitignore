# Python
__pycache__/
*.py[cod]
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/

# 모델 가중치 — 레포에 넣지 않는다 (최초 실행 시 자동 다운로드)
*.pt
*.onnx
# 웹 시연판은 모델을 함께 배포해야 한다 (GitHub Pages 가 서빙한다)
!docs/*.onnx
*_ncnn_model/
*_openvino_model/

# 런타임 산출물
captures/
logs/
runs/
test_output/
*.mp4
*.avi

# 현장 캘리브레이션 결과는 촬영 장소마다 다르므로 공유하지 않는다
calibration/*.json
!calibration/example_ground_plane.json

# 환경 변수
.env

# OS / 에디터
.DS_Store
.idea/
.vscode/
*.swp

# 애니메이션 중간 산출물 (patent/anim 스크립트로 다시 만든다)
patent/anim/frames/
patent/anim/frames_hud/
patent/anim/stills/
patent/anim/*.blend1

# 특허 출원 전 공개 금지 (저장소가 PUBLIC). 출원 후 이 줄을 지운다.
patent/
