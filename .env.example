# ─── 입력 소스 ──────────────────────────────────────────────────
# IP Webcam URL | 웹캠 번호 | 동영상 파일 | "csi" (라즈베리파이 카메라 모듈 3)
STREAM_SOURCE=http://192.168.0.10:8080/video
CAPTURE_WIDTH=1280
CAPTURE_HEIGHT=720
CAPTURE_FPS=30

# ─── 모델 ───────────────────────────────────────────────────────
YOLO_MODEL=yolov8n.pt
YOLO_DEVICE=auto          # auto | mps | cpu | cuda
YOLO_IMGSZ=640            # 라즈베리파이 4 에서는 320
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.5

# ─── 추적 ───────────────────────────────────────────────────────
USE_TRACKING=true
TRACKER=bytetrack.yaml

# ─── 그리드 ─────────────────────────────────────────────────────
GRID_ROWS=3
GRID_COLS=3

# ─── 임계치 (캘리브레이션 없을 때: 셀당 인원수) ──────────────────
GRID_WARN_THRESHOLD=3
GRID_DANGER_THRESHOLD=5
TOTAL_DANGER_THRESHOLD=15

# ─── 임계치 (캘리브레이션 있을 때: persons/m^2) ──────────────────
# 2.0 보행 저하 / 4.0 자력 이동 곤란 / 5.0+ 군중 압착 위험
DENSITY_WARN=2.0
DENSITY_DANGER=4.0
GROUND_PLANE=calibration/ground_plane.json

# ─── 카메라 기하 (Camera Module 3 Wide 기준) ─────────────────────
HFOV_DEG=102.0
VFOV_DEG=67.0
CAMERA_PITCH_DEG=90.0     # 90 = 수직 하향(나디르)
ALTITUDE_M=0.0            # 0 = 미지정. 주면 타겟을 미터 오프셋으로 환산

# ─── 시간축 안정화 ──────────────────────────────────────────────
ALERT_WINDOW=15
ALERT_ON_RATIO=0.6
ALERT_OFF_RATIO=0.25
ALERT_MIN_ON_S=5.0
COUNT_WINDOW=9
HEATMAP_ALPHA=0.35
