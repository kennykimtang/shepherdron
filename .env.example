# Shepherdron 비전 모듈 환경 설정 예시
# 실제 사용 시 .env 파일로 복사 후 본인의 스마트폰 IP 주소에 맞게 수정하세요.

# 1. 비디오 스트림 소스 (IP Webcam 앱 화면 하단에 표시되는 IPv4 주소)
# 예: http://192.168.0.15:8080/video
STREAM_SOURCE=http://192.168.0.10:8080/video

# 2. YOLOv8 설정
YOLO_MODEL=yolov8n.pt
CONF_THRESHOLD=0.45
IOU_THRESHOLD=0.5
YOLO_DEVICE=auto

# 3. 그리드 및 밀집도 판정 기준
GRID_ROWS=3
GRID_COLS=3
GRID_WARN_THRESHOLD=3
GRID_DANGER_THRESHOLD=5
TOTAL_DANGER_THRESHOLD=15
